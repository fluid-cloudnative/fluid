# Build the jindoruntime-controller manager binary
# golang:1.26.11-bookworm
FROM golang:1.26.11-bookworm@sha256:dc40a13b61304647ed7e5d581d246b86413dfc29d63c6d018310feb93cd98fc0 as builder

WORKDIR /go/src/github.com/fluid-cloudnative/fluid
COPY hack/download-helm.sh hack/download-helm.sh

ARG HELM_VERSION=v3.19.5
RUN hack/download-helm.sh ${HELM_VERSION}

COPY . .

ARG FLUID_VERSION
RUN make jindoruntime-controller-build && \
    cp bin/jindoruntime-controller /go/bin/jindoruntime-controller
RUN bash hack/helm/pin_runtime_chart_version.sh "${FLUID_VERSION}"

# alpine:3.23.3
FROM alpine:3.23.3@sha256:25109184c71bdad752c8312a8623239686a9a2071e8825f20acb8f2198c3f659
RUN apk add --update bash curl wget iproute2 libc6-compat tzdata vim &&  \
 	rm -rf /var/cache/apk/*

ARG TARGETARCH
ARG HELM_VERSION=v3.19.5
COPY --from=builder /go/src/github.com/fluid-cloudnative/fluid/bin/helm/${HELM_VERSION}/helm-linux-${TARGETARCH} /usr/local/bin/ddc-helm
RUN chmod u+x /usr/local/bin/ddc-helm

COPY --from=builder /go/src/github.com/fluid-cloudnative/fluid/charts/library /charts/library
COPY --from=builder /go/src/github.com/fluid-cloudnative/fluid/charts/jindofs /charts/jindofs
COPY --from=builder /go/src/github.com/fluid-cloudnative/fluid/charts/jindofsx /charts/jindofsx
COPY --from=builder /go/src/github.com/fluid-cloudnative/fluid/charts/jindocache /charts/jindocache

COPY --from=builder /go/bin/jindoruntime-controller /usr/local/bin/jindoruntime-controller
#COPY --from=builder /go/bin/dlv /usr/local/bin/dlv
RUN chmod -R u+x /usr/local/bin/

CMD ["jindoruntime-controller", "start"]

